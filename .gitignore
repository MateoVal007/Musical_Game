# Este .gitignore es el estándar de Unity (basado en el template oficial de GitHub para Unity).
# Ignora todo lo que Unity regenera solo y lo que es pesado/binario sin necesidad de versionar.

# Carpetas generadas por Unity
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/

# Archivos de Asset meta generados por packages (no tocar a mano)
/[Aa]ssets/[Aa]ssetStoreTools*

# Archivos de proyectos de IDE (Visual Studio / Rider / VS Code)
.vs/
.vscode/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Archivos de OS
.DS_Store
Thumbs.db

# Autogenerado por Unity al abrir el proyecto
/[Aa]ssets/[Aa]ddressableAssetsData/*/*.bin*
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# Crash reports
sysinfo.txt

# Archivos de compilación
*.apk
*.aab
*.unitypackage
*.app

# Nube / colaboración (si algún día usan Unity Cloud Build o similar)
.gradle/
ExportedObj/
.consulo/
crashlytics-build.properties
